@@ -0,0 +1,82 @@
+import { Pressable, StyleSheet, View } from 'react-native';
+
+import { Card } from '@/components/panel/card';
+import { Txt } from '@/components/panel/txt';
+import { SgcRadius, SgcSpacing } from '@/constants/sgc-theme';
+import { useSgcTheme } from '@/hooks/use-sgc-theme';
+import type { ConflictoFirma } from '@/lib/concurrencia-firma';
+
+type Props = {
+  conflicto: ConflictoFirma;
+  /** Hay una firma dibujada o un comentario en borrador que se podría conservar. */
+  hayBorrador: boolean;
+  onRecargar: () => void;
+  onConservar: () => void;
+  onDescartar: () => void;
+};
+
+/** Aviso de conflicto de versión: la persona decide qué hacer con lo que ya cargó. */
+export function ConflictoFirmaCard({
+  conflicto,
+  hayBorrador,
+  onRecargar,
+  onConservar,
+  onDescartar,
+}: Props) {
+  const tema = useSgcTheme();
+  // Si el convenio ya no está pendiente no hay versión vigente sobre la cual conservar nada.
+  const sePuedeConservar = conflicto.actual !== null && hayBorrador;
+  const sePuedeRecargar = conflicto.actual !== null;
+
+  return (
+    <Card titulo="Conflicto de versión" bordeSuperior={tema.warning}>
+      <View accessibilityRole="alert" style={styles.cuerpo}>
+        <Txt color="textSecondary">{conflicto.mensaje}</Txt>
+        {conflicto.cambios.map((cambio) => (
+          <Txt key={cambio} variante="detalle" color="textSecondary">
+            • {cambio}
+          </Txt>
+        ))}
+        <Txt variante="detalle" color="textSecondary">
+          Por seguridad no se firmó nada. Revisá la versión vigente antes de volver a confirmar.
+        </Txt>
+      </View>
+
+      {sePuedeRecargar ? (
+        <Pressable
+          accessibilityRole="button"
+          onPress={onRecargar}
+          style={[styles.boton, { backgroundColor: tema.brand }]}>
+          <Txt negrita color="onBrand">Recargar versión vigente</Txt>
+        </Pressable>
+      ) : null}
+
+      {sePuedeConservar ? (
+        <Pressable
+          accessibilityRole="button"
+          onPress={onConservar}
+          style={[styles.botonSecundario, { borderColor: tema.brand }]}>
+          <Txt negrita style={{ color: tema.brandText }}>Conservar mi firma y comentario</Txt>
+        </Pressable>
+      ) : null}
+
+      <Pressable
+        accessibilityRole="button"
+        onPress={onDescartar}
+        style={[styles.botonSecundario, { borderColor: tema.border }]}>
+        <Txt negrita>Descartar mis cambios</Txt>
+      </Pressable>
+    </Card>
+  );
+}
+
+const styles = StyleSheet.create({
+  cuerpo: { gap: SgcSpacing.sm },
+  boton: { borderRadius: SgcRadius.sm, paddingVertical: SgcSpacing.md, alignItems: 'center' },
+  botonSecundario: {
+    borderWidth: 1,
+    borderRadius: SgcRadius.sm,
+    paddingVertical: SgcSpacing.md,
+    alignItems: 'center',
+  },
+});
diff --git a/app/src/lib/concurrencia-firma.ts b/app/src/lib/concurrencia-firma.ts
new file mode 100644
index 0000000..b08ed54
--- /dev/null
+++ b/app/src/lib/concurrencia-firma.ts
@@ -0,0 +1,65 @@
+import type { PendienteFirmaCompleto } from '@/types/firma';
+
+export type MotivoConflicto = 'modificado' | 'documento' | 'no-disponible';
+
+export type ConflictoFirma = {
+  motivo: MotivoConflicto;
+  /** Estado vigente en el servidor; null si el convenio ya no está pendiente de firma. */
+  actual: PendienteFirmaCompleto | null;
+  /** Qué cambió, listo para mostrar. */
+  cambios: string[];
+  mensaje: string;
+};
+
+const MENSAJES: Record<MotivoConflicto, string> = {
+  modificado: 'El convenio fue modificado por otra persona desde que lo abriste.',
+  documento: 'El documento a firmar cambió desde que lo abriste.',
+  'no-disponible':
+    'Este convenio ya no está pendiente de tu firma (cambió de estado o ya fue firmado).',
+};
+
+/**
+ * Compara lo que la persona tiene abierto con lo que hay hoy en el servidor.
+ * Devuelve null si no hubo cambios y se puede firmar sin riesgo.
+ *
+ * Además de `version_registro` se compara el documento: la API no suma versión al
+ * reemplazar un PDF, y firmar sobre un PDF distinto del que se leyó es el caso más grave.
+ */
+export function detectarConflicto(
+  local: PendienteFirmaCompleto,
+  actual: PendienteFirmaCompleto | undefined,
+  mensajeServidor?: string,
+): ConflictoFirma | null {
+  if (!actual) {
+    return {
+      motivo: 'no-disponible',
+      actual: null,
+      cambios: [],
+      mensaje: mensajeServidor ?? MENSAJES['no-disponible'],
+    };
+  }
+
+  const cambios: string[] = [];
+
+  if (actual.version_registro !== local.version_registro) {
+    cambios.push(`Versión del convenio: ${local.version_registro} → ${actual.version_registro}`);
+  }
+
+  const documentoCambio =
+    local.documento?.id_documento !== actual.documento?.id_documento ||
+    local.documento?.id_version !== actual.documento?.id_version;
+
+  if (documentoCambio) {
+    cambios.push(
+      actual.documento
+        ? `Documento: ahora es "${actual.documento.nombre_archivo}"`
+        : 'El convenio ya no tiene un documento listo para firmar',
+    );
+  }
+
+  if (cambios.length === 0) return null;
+
+  const motivo: MotivoConflicto = documentoCambio ? 'documento' : 'modificado';
+
+  return { motivo, actual, cambios, mensaje: MENSAJES[motivo] };
+}
