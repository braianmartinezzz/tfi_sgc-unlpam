+++ b/app/__tests__/api-client.test.ts
@@ -0,0 +1,65 @@
+import { router } from 'expo-router';
+
+import { getToken } from '@/lib/auth-storage';
+import { consumirSesionVencida } from '@/lib/sesion-estado';
+import { ApiError, NetworkError, apiRequest } from '@/services/api-client';
+
+jest.mock('@/lib/auth-storage', () => ({ getToken: jest.fn(), clearToken: jest.fn(async () => undefined) }));
+
+const { clearToken } = jest.requireMock('@/lib/auth-storage');
+const fetchMock = jest.fn();
+(globalThis as { fetch: unknown }).fetch = fetchMock;
+
+const respuesta = (status: number, cuerpo: unknown = {}) => ({
+  ok: status >= 200 && status < 300,
+  status,
+  json: async () => cuerpo,
+});
+
+beforeEach(() => {
+  consumirSesionVencida();
+  (getToken as jest.Mock).mockResolvedValue('token-1');
+});
+
+describe('sesión expirada y renovación', () => {
+  it('envía el token y devuelve el JSON', async () => {
+    fetchMock.mockResolvedValue(respuesta(200, { ok: 1 }));
+
+    await expect(apiRequest('/me')).resolves.toEqual({ ok: 1 });
+    expect(fetchMock.mock.calls[0][1].headers.Authorization).toBe('Bearer token-1');
+  });
+
+  it('ante un 401 con sesión: limpia el token, marca el vencimiento y vuelve al login', async () => {
+    fetchMock.mockResolvedValue(respuesta(401, { message: 'Unauthenticated.' }));
+
+    await expect(apiRequest('/panel')).rejects.toMatchObject({ status: 401 });
+    await new Promise((r) => setImmediate(r));
+
+    expect(clearToken).toHaveBeenCalledTimes(1);
+    expect(router.replace).toHaveBeenCalledWith('/');
+    expect(consumirSesionVencida()).toBe(true);
+    expect(consumirSesionVencida()).toBe(false);
+  });
+
+  it('no trata como vencimiento el 401 del propio logout ni el de pedidos sin token', async () => {
+    fetchMock.mockResolvedValue(respuesta(401));
+    await expect(apiRequest('/logout', { method: 'POST' })).rejects.toBeInstanceOf(ApiError);
+
+    (getToken as jest.Mock).mockResolvedValue(null);
+    await expect(apiRequest('/app/login', { method: 'POST' })).rejects.toBeInstanceOf(ApiError);
+
+    expect(clearToken).not.toHaveBeenCalled();
+  });
+});
+
+describe('errores', () => {
+  it('usa el mensaje de la API (422)', async () => {
+    fetchMock.mockResolvedValue(respuesta(422, { message: 'Código incorrecto.' }));
+    await expect(apiRequest('/x')).rejects.toMatchObject({ status: 422, message: 'Código incorrecto.' });
+  });
+
+  it('si no hay red lanza NetworkError', async () => {
+    fetchMock.mockRejectedValue(new TypeError('Network request failed'));
+    await expect(apiRequest('/x')).rejects.toBeInstanceOf(NetworkError);
+  });
+});
diff --git a/app/__tests__/firma-y-biometria.test.ts b/app/__tests__/firma-y-biometria.test.ts
new file mode 100644
index 0000000..4e49b06
--- /dev/null
+++ b/app/__tests__/firma-y-biometria.test.ts
@@ -0,0 +1,77 @@
+import * as Location from 'expo-location';
+import * as LocalAuthentication from 'expo-local-authentication';
+
+import { biometriaDisponible, confirmarConBiometria } from '@/services/biometria-login';
+import { UbicacionError, obtenerUbicacionParaFirma } from '@/services/ubicacion-firma';
+
+jest.mock('expo-location', () => ({
+  requestForegroundPermissionsAsync: jest.fn(),
+  hasServicesEnabledAsync: jest.fn(),
+  getCurrentPositionAsync: jest.fn(),
+  Accuracy: { Balanced: 3 },
+}));
+jest.mock('expo-local-authentication', () => ({
+  hasHardwareAsync: jest.fn(),
+  isEnrolledAsync: jest.fn(),
+  authenticateAsync: jest.fn(),
+}));
+
+const L = Location as jest.Mocked<typeof Location>;
+const A = LocalAuthentication as jest.Mocked<typeof LocalAuthentication>;
+
+describe('confirmación de permisos de ubicación', () => {
+  beforeEach(() => {
+    L.requestForegroundPermissionsAsync.mockResolvedValue({ status: 'granted', canAskAgain: true } as never);
+    L.hasServicesEnabledAsync.mockResolvedValue(true);
+    L.getCurrentPositionAsync.mockResolvedValue({ coords: { latitude: -36.6, longitude: -64.3 } } as never);
+  });
+
+  it('con permiso devuelve latitud y longitud', async () => {
+    await expect(obtenerUbicacionParaFirma()).resolves.toEqual({ latitud: -36.6, longitud: -64.3 });
+  });
+
+  it('permiso denegado: se puede volver a pedir', async () => {
+    L.requestForegroundPermissionsAsync.mockResolvedValue({ status: 'denied', canAskAgain: true } as never);
+    const error = await obtenerUbicacionParaFirma().catch((e) => e);
+
+    expect(error).toBeInstanceOf(UbicacionError);
+    expect(error.bloqueado).toBe(false);
+  });
+
+  it('permiso bloqueado: indica ir a los ajustes', async () => {
+    L.requestForegroundPermissionsAsync.mockResolvedValue({ status: 'denied', canAskAgain: false } as never);
+    expect(await obtenerUbicacionParaFirma().catch((e) => e)).toMatchObject({ bloqueado: true });
+  });
+
+  it('GPS apagado y falla de lectura tienen mensaje propio', async () => {
+    L.hasServicesEnabledAsync.mockResolvedValue(false);
+    await expect(obtenerUbicacionParaFirma()).rejects.toThrow(/GPS/);
+
+    L.hasServicesEnabledAsync.mockResolvedValue(true);
+    L.getCurrentPositionAsync.mockRejectedValue(new Error('timeout'));
+    await expect(obtenerUbicacionParaFirma()).rejects.toThrow(/No se pudo obtener tu ubicación/);
+  });
+});
+
+describe('biometría', () => {
+  it('disponible solo con sensor y huella/rostro cargado', async () => {
+    A.hasHardwareAsync.mockResolvedValue(true);
+    A.isEnrolledAsync.mockResolvedValue(true);
+    expect(await biometriaDisponible()).toBe(true);
+
+    A.isEnrolledAsync.mockResolvedValue(false);
+    expect(await biometriaDisponible()).toBe(false);
+  });
+
+  it('la confirmación nunca acepta el PIN del celular', async () => {
+    A.authenticateAsync.mockResolvedValue({ success: true } as never);
+    expect(await confirmarConBiometria('Firmar')).toBe(true);
+    expect(A.authenticateAsync).toHaveBeenCalledWith(expect.objectContaining({ disableDeviceFallback: true }));
+
+    A.authenticateAsync.mockResolvedValue({ success: false } as never);
+    expect(await confirmarConBiometria('Firmar')).toBe(false);
+
+    A.authenticateAsync.mockRejectedValue(new Error('lockout'));
+    expect(await confirmarConBiometria('Firmar')).toBe(false);
+  });
+});
diff --git a/app/__tests__/login-y-sesion.test.ts b/app/__tests__/login-y-sesion.test.ts
new file mode 100644
index 0000000..83e7d8d
--- /dev/null
+++ b/app/__tests__/login-y-sesion.test.ts
@@ -0,0 +1,87 @@
+import { agregarCola, guardarOffline, leerCola, leerOffline } from '@/lib/offline-storage';
+import { ApiError, NetworkError } from '@/services/api-client';
+import {
+  activarBiometria,
+  enviarCodigoMfa,
+  iniciarLogin,
+  loginBiometrico,
+  mensajeDeError,
+  verificarCodigoMfa,
+} from '@/services/auth-app';
+import { cerrarSesion } from '@/services/auth';
+
+jest.mock('@/lib/auth-storage', () => ({ getToken: jest.fn(), clearToken: jest.fn(async () => undefined) }));
+jest.mock('@/services/push-token', () => ({ eliminarPushToken: jest.fn(async () => undefined) }));
+jest.mock('@/services/api-client', () => {
+  const actual = jest.requireActual('@/services/api-client');
+  return { ...actual, apiRequest: jest.fn() };
+});
+
+const { apiRequest } = jest.requireMock('@/services/api-client');
+const { clearToken } = jest.requireMock('@/lib/auth-storage');
+
+describe('login con correo, SMS y push', () => {
+  beforeEach(() => apiRequest.mockResolvedValue({}));
+
+  it('paso 1 envía mail y contraseña', async () => {
+    await iniciarLogin('a@unlpam.edu.ar', 'clave');
+    expect(apiRequest).toHaveBeenCalledWith('/app/login', {
+      method: 'POST',
+      body: JSON.stringify({ mail: 'a@unlpam.edu.ar', password: 'clave' }),
+    });
+  });
+
+  it.each([
+    ['mail', undefined, null],
+    ['sms', undefined, null],
+    ['push', 'ExponentPushToken[abc]', 'ExponentPushToken[abc]'],
+  ] as const)('paso 2 por %s', async (canal, entrada, esperado) => {
+    await enviarCodigoMfa('mfa-1', canal, entrada);
+    expect(JSON.parse(apiRequest.mock.calls[0][1].body)).toEqual({
+      mfa_token: 'mfa-1',
+      canal,
+      push_token: esperado,
+    });
+  });
+
+  it('paso 3 verifica el código', async () => {
+    await verificarCodigoMfa('mfa-1', '123456');
+    expect(JSON.parse(apiRequest.mock.calls[0][1].body)).toEqual({ mfa_token: 'mfa-1', codigo: '123456' });
+  });
+
+  it('muestra el mensaje de la API o de red, y uno por defecto para lo inesperado', () => {
+    expect(mensajeDeError(new ApiError(422, 'Código incorrecto.'), 'x')).toBe('Código incorrecto.');
+    expect(mensajeDeError(new NetworkError(), 'x')).toMatch(/conectar/);
+    expect(mensajeDeError(new Error('raro'), 'Falló')).toBe('Falló');
+  });
+});
+
+describe('activación y uso de biometría', () => {
+  it('activar devuelve el token del dispositivo', async () => {
+    apiRequest.mockResolvedValue({ token_dispositivo: 'dev-1' });
+    await expect(activarBiometria('clave')).resolves.toBe('dev-1');
+  });
+
+  it('el ingreso usa el token del dispositivo como Bearer', async () => {
+    apiRequest.mockResolvedValue({});
+    await loginBiometrico('dev-1');
+    expect(apiRequest).toHaveBeenCalledWith('/app/login/biometrico', {
+      method: 'POST',
+      headers: { Authorization: 'Bearer dev-1' },
+    });
+  });
+});
+
+describe('cerrar sesión', () => {
+  it('cierra aunque el servidor no responda y borra los datos offline', async () => {
+    apiRequest.mockRejectedValue(new NetworkError());
+    await guardarOffline('panel_latest', { dato: 1 });
+    await agregarCola({ method: 'PATCH', path: '/a' });
+
+    await expect(cerrarSesion()).resolves.toBeUndefined();
+
+    expect(clearToken).toHaveBeenCalled();
+    expect(await leerOffline('panel_latest')).toBeNull();
+    expect(await leerCola()).toEqual([]);
+  });
+});
diff --git a/app/__tests__/offline-sync.test.ts b/app/__tests__/offline-sync.test.ts
new file mode 100644
index 0000000..cb7b57e
--- /dev/null
+++ b/app/__tests__/offline-sync.test.ts
@@ -0,0 +1,126 @@
+import NetInfo from '@react-native-community/netinfo';
+
+import {
+  agregarCola,
+  asegurarCacheDelUsuario,
+  guardarOffline,
+  leerCola,
+  leerOffline,
+  limpiarOffline,
+} from '@/lib/offline-storage';
+import { leerInstantaneaEnMemoria, guardarInstantaneaEnMemoria } from '@/lib/panel-memoria';
+import { ApiError, NetworkError } from '@/services/api-client';
+import { MAX_INTENTOS, sincronizarCola } from '@/services/offline-sync';
+import { marcarNotificacionLeida } from '@/services/notificaciones';
+
+jest.mock('@/services/api-client', () => {
+  const actual = jest.requireActual('@/services/api-client');
+  return { ...actual, apiRequest: jest.fn() };
+});
+
+const { apiRequest } = jest.requireMock('@/services/api-client');
+const conRed = (valor: boolean) =>
+  (NetInfo.fetch as jest.Mock).mockResolvedValue({ isConnected: valor, isInternetReachable: valor });
+
+beforeEach(async () => {
+  await limpiarOffline();
+  conRed(true);
+  apiRequest.mockReset();
+});
+
+const encolar = (path: string) => agregarCola({ method: 'PATCH', path });
+
+describe('cola offline y sincronización', () => {
+  it('sin conexión no envía nada y conserva la cola', async () => {
+    await encolar('/a');
+    conRed(false);
+
+    expect(await sincronizarCola()).toEqual({ procesadas: 0, descartadas: 0, pendientes: 1 });
+    expect(apiRequest).not.toHaveBeenCalled();
+  });
+
+  it('con conexión envía en orden y vacía la cola', async () => {
+    await encolar('/a');
+    await encolar('/b');
+    apiRequest.mockResolvedValue({});
+
+    expect(await sincronizarCola()).toEqual({ procesadas: 2, descartadas: 0, pendientes: 0 });
+    expect(apiRequest.mock.calls.map((c: unknown[]) => c[0])).toEqual(['/a', '/b']);
+  });
+
+  it('si la red cae a mitad de camino, lo ya enviado no se reenvía después', async () => {
+    await encolar('/a');
+    await encolar('/b');
+    apiRequest.mockResolvedValueOnce({}).mockRejectedValueOnce(new NetworkError());
+
+    expect(await sincronizarCola()).toMatchObject({ procesadas: 1, pendientes: 1 });
+    expect((await leerCola()).map((o) => o.path)).toEqual(['/b']);
+
+    apiRequest.mockResolvedValue({});
+    await sincronizarCola();
+    expect(apiRequest.mock.calls.map((c: unknown[]) => c[0])).toEqual(['/a', '/b', '/b']);
+  });
+
+  it('un rechazo definitivo (422/404) se descarta y no traba las demás', async () => {
+    await encolar('/mala');
+    await encolar('/buena');
+    apiRequest.mockRejectedValueOnce(new ApiError(404, 'No existe')).mockResolvedValueOnce({});
+
+    expect(await sincronizarCola()).toEqual({ procesadas: 1, descartadas: 1, pendientes: 0 });
+  });
+
+  it('con 401 corta y conserva todo para cuando se vuelva a iniciar sesión', async () => {
+    await encolar('/a');
+    apiRequest.mockRejectedValue(new ApiError(401, 'Unauthenticated.'));
+
+    expect(await sincronizarCola()).toMatchObject({ procesadas: 0, descartadas: 0, pendientes: 1 });
+    expect((await leerCola())[0].attempts).toBe(0);
+  });
+
+  it('una falla del servidor cuenta intentos y al llegar al máximo se descarta', async () => {
+    await encolar('/a');
+    apiRequest.mockRejectedValue(new ApiError(500, 'Error'));
+
+    for (let i = 1; i < MAX_INTENTOS; i++) {
+      await sincronizarCola();
+      expect((await leerCola())[0].attempts).toBe(i);
+    }
+
+    expect(await sincronizarCola()).toMatchObject({ descartadas: 1, pendientes: 0 });
+  });
+
+  it('marcar una notificación como leída sin red queda en la cola', async () => {
+    apiRequest.mockRejectedValueOnce(new NetworkError());
+
+    expect(await marcarNotificacionLeida(7)).toBe(false);
+    expect(await leerCola()).toMatchObject([{ method: 'PATCH', path: '/notificaciones/7/leida' }]);
+  });
+
+  it('un error de la API al marcar leída no se encola', async () => {
+    apiRequest.mockRejectedValueOnce(new ApiError(404, 'No existe'));
+
+    await expect(marcarNotificacionLeida(7)).rejects.toBeInstanceOf(ApiError);
+    expect(await leerCola()).toEqual([]);
+  });
+});
+
+describe('lectura offline del panel: datos por usuario', () => {
+  const instantanea = { me: { id_usuario: 1 }, panel: {}, actualizado: new Date() } as never;
+
+  it('el mismo usuario conserva panel y cola; otro usuario los pierde', async () => {
+    await asegurarCacheDelUsuario(1);
+    await guardarOffline('panel_latest', { dato: 1 });
+    guardarInstantaneaEnMemoria(instantanea);
+    await encolar('/a');
+
+    await asegurarCacheDelUsuario(1);
+    expect(await leerOffline('panel_latest')).toEqual({ dato: 1 });
+    expect(await leerCola()).toHaveLength(1);
+
+    await asegurarCacheDelUsuario(2);
+    expect(await leerOffline('panel_latest')).toBeNull();
+    expect(await leerCola()).toEqual([]);
+    expect(leerInstantaneaEnMemoria()).toBeNull();
+    expect(await leerOffline('duenio_cache')).toBe(2);
+  });
+});
